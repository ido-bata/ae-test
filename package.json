{
  "name": "@ido-bata/ae-test",
  "version": "0.0.0",
  "description": "Playwright-like automated testing framework for After Effects",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ae-test": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --no-error-on-unmatched-pattern",
    "test": "npm run build && vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "ae-test": "npm run build && node dist/cli.js"
  },
  "dependencies": {
    "@ido-bata/ae-a8n": "0.1.0-alpha.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
